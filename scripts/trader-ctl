#!/bin/bash
# trader-ctl — start or stop this laptop as the authoritative options-trader host.
#
#   trader-ctl start    make THIS laptop the trading machine
#   trader-ctl stop     stand THIS laptop down
#   trader-ctl status   report what this laptop is doing
#
# Scope: the launchd scheduler daemon, plus a reminder about the
# verify-daily-pipeline scheduled task (which only Claude can toggle).
# daily-stocks-briefing is deliberately NOT touched — it is harmless on both
# machines and its CSV output is per-laptop.
#
# THE RULE THIS EXISTS TO ENFORCE: exactly one laptop runs the scheduler.
# The duplicate-instance lock is an flock on a local file and cannot see
# another machine. Two running schedulers means two sets of live orders.

set -uo pipefail

LABEL="com.ambrish.options-trader"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
REPO="${TRADER_REPO:-$HOME/Code/options_trader}"   # overridable for testing
HOST=$(scutil --get LocalHostName 2>/dev/null || hostname -s)
ASSUME_YES=0
NO_PULL=0
REF_OVERRIDE=""
PIN_FILE="$HOME/.config/trader-ctl/pin"

g() { printf "\033[32m%s\033[0m" "$1"; }
r() { printf "\033[31m%s\033[0m" "$1"; }
y() { printf "\033[33m%s\033[0m" "$1"; }
b() { printf "\033[1m%s\033[0m" "$1"; }
say()  { printf "  %s\n" "$1"; }
head_() { printf "\n"; b "$1"; printf "\n"; }   # never build the format from an expansion

usage() {
  cat <<EOF
usage: trader-ctl {start|stop|status|pin} [-y] [--no-pull] [--ref REF]

  start        update code, preflight, then bootstrap the scheduler and verify it
  stop         bootout the scheduler on this laptop and confirm it is gone
  status       report scheduler state, trading gate, pin, and artifact freshness
  pin REF      always start from REF (a tag or commit) instead of tracking main
  pin --clear  go back to tracking main

  -y           skip the confirmation prompt on 'start'
  --no-pull    start without updating at all (offline, or to freeze on disk)
  --ref REF    update to REF just this once, ignoring any saved pin

Pinning is per-laptop and lives in ~/.config/trader-ctl/pin, deliberately
outside the repo so it survives checkouts and is never itself pulled.
EOF
  exit 2
}

# ---- helpers ---------------------------------------------------------------

# The interpreter launchd will actually run. TRADER_PYTHON overrides it so a
# test against a throwaway TRADER_REPO cannot pip-install into the production
# environment — redirecting the repo alone does not redirect the interpreter,
# and sync_deps installs into whatever this returns.
plist_python() {
  if [ -n "${TRADER_PYTHON:-}" ]; then printf '%s' "$TRADER_PYTHON"; return; fi
  grep -A2 ProgramArguments "$PLIST" 2>/dev/null | grep string | head -1 \
    | sed 's/.*<string>//;s/<\/string>//'
}

running_pids() { pgrep -f "main\.py --schedule" 2>/dev/null; }
running_count() { running_pids | grep -c . ; }

launchd_line() { launchctl list 2>/dev/null | grep -F "$LABEL"; }

gate_value() {
  local py; py=$(plist_python)
  [ -x "$py" ] || { echo "unknown"; return; }
  (cd "$REPO" && "$py" -c "import scheduler; print(scheduler._force_dry_run)" 2>/dev/null) || echo "unknown"
}

# ---- status ----------------------------------------------------------------

do_status() {
  printf "\n"; b "options-trader on $HOST"; printf "  %s\n" "$(date '+%a %Y-%m-%d %H:%M %Z')"

  head_ "scheduler"
  local line n; line=$(launchd_line); n=$(running_count)
  if [ -z "$line" ]; then
    say "launchd job:  $(y "NOT LOADED")  — this laptop is stood down"
  else
    local lpid lst; lpid=$(echo "$line" | awk '{print $1}'); lst=$(echo "$line" | awk '{print $2}')
    if [ "$lpid" = "-" ]; then
      say "launchd job:  $(y "loaded but not running")  (last exit $lst)"
    else
      say "launchd job:  $(g "RUNNING")  pid=$lpid  (last exit $lst)"
      say "uptime:       $(ps -p "$lpid" -o etime= 2>/dev/null | tr -d ' ')"
    fi
  fi
  case "$n" in
    0) say "processes:    none" ;;
    1) say "processes:    $(g "1")  (correct)" ;;
    *) say "processes:    $(r "$n — DUPLICATE on this machine")" ;;
  esac

  head_ "trading gate"
  local gv; gv=$(gate_value)
  case "$gv" in
    False) say "_force_dry_run = $(g "False")  — would place real orders" ;;
    True)  say "_force_dry_run = $(r "True")   — TRADING DISABLED (TRADER_DATA_DIR set?)" ;;
    *)     say "_force_dry_run = $(y "unknown")" ;;
  esac

  head_ "artifacts"
  local rm ig csv
  rm=$(ls -1t "$REPO"/logs/run_*.json 2>/dev/null | head -1)
  ig=$(ls -1t "$REPO"/snapshots/ig_ledger_*.jsonl 2>/dev/null | head -1)
  csv=$(ls -1t "$REPO"/snapshots/Strategy-Purchase-*.csv 2>/dev/null | head -1)
  say "newest run marker:   $([ -n "$rm" ]  && basename "$rm"  || echo none)"
  say "newest ig ledger:    $([ -n "$ig" ]  && basename "$ig"  || echo none)"
  say "newest strategy CSV: $([ -n "$csv" ] && basename "$csv" || echo none)"

  head_ "code"
  local pin; pin=$(current_pin)
  if [ -n "$pin" ]; then say "pinned to:  $(b "$pin")"; else say "tracking:   main"; fi
  say "at commit:  $(cd "$REPO" && git log --oneline -1 2>/dev/null | cut -c1-60)"

  head_ "not managed by this script"
  say "verify-daily-pipeline  — ask Claude on this laptop: \"list my scheduled tasks\""
  say "daily-stocks-briefing  — harmless on both laptops, left alone by design"
  echo
}

# Did requirements.lock change between two revisions? Uses git rather than a
# checksum tool: git is already required here, whereas `md5` is macOS-only and
# its absence made both sides compare equal — silently skipping the install.
lockfile_changed() {
  [ -n "$(git diff --name-only "$1" "$2" -- requirements.lock 2>/dev/null)" ]
}

sync_deps() {
  if [ ! -f "$REPO/requirements.lock" ]; then
    say "$(y "no requirements.lock at this ref — leaving dependencies as they are")"
    return 0
  fi
  say "$(y "requirements.lock changed — installing")"
  local py; py=$(plist_python)
  if "$py" -m pip install -q -r "$REPO/requirements.lock" 2>&1 | tail -3 | sed 's/^/      /'; then
    say "dependencies synced"
  else
    say "$(r "dependency install failed — preflight will catch it")"
  fi
}

# ---- pin -------------------------------------------------------------------

current_pin() { [ -f "$PIN_FILE" ] && tr -d '[:space:]' < "$PIN_FILE" || true; }

do_pin() {
  local ref="${1:-}"
  if [ -z "$ref" ]; then
    local p; p=$(current_pin)
    [ -n "$p" ] && say "pinned to $(b "$p")" || say "not pinned — tracking main"
    return 0
  fi
  if [ "$ref" = "--clear" ]; then
    rm -f "$PIN_FILE"; say "pin cleared — will track main"; return 0
  fi
  cd "$REPO" || { say "$(r "no repo at $REPO")"; return 1; }
  git fetch --tags --quiet origin 2>/dev/null
  if ! git rev-parse --verify --quiet "${ref}^{commit}" >/dev/null; then
    say "$(r "no such tag or commit: $ref")"; return 1
  fi
  mkdir -p "$(dirname "$PIN_FILE")" && printf "%s\n" "$ref" > "$PIN_FILE"
  say "pinned to $(b "$ref")  ($(git log --oneline -1 "$ref" | cut -c1-60))"
  say "'trader-ctl start' will check this out instead of tracking main"
}

# ---- update ----------------------------------------------------------------
# Pull before starting, so whichever laptop takes over runs current code.
# Never rewrites history and never discards local work: --ff-only only, and a
# tracked-file modification aborts rather than being stashed or clobbered.

do_update() {
  head_ "updating code"
  cd "$REPO" 2>/dev/null || { say "$(r "no repo at $REPO")"; return 1; }

  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    say "$(y "not a git repo — skipping update")"; return 0
  fi

  # Tracked modifications block in every mode. Untracked files (scheduler.pid,
  # logs, etc.) are fine — git complains by itself if one is genuinely in the way.
  if ! git diff --quiet || ! git diff --cached --quiet; then
    say "$(r "uncommitted changes to tracked files — refusing to update")"
    git --no-pager diff --stat | tail -5 | sed 's/^/      /'
    say "commit or discard them, then re-run"
    return 1
  fi

  # Captured before any checkout below can move HEAD. Recovering from a
  # detached pin back to main changes the tree, and taking `before` after that
  # checkout compared main against itself — so a requirements.lock change
  # between the pinned ref and main went unnoticed and was never installed.
  local started_at; started_at=$(git rev-parse HEAD)

  local pin; pin="${REF_OVERRIDE:-$(current_pin)}"
  if [ -n "$pin" ]; then
    # Pinned: check out an exact ref. Detached HEAD is correct here, not a fault.
    git fetch --tags --quiet origin 2>/dev/null || say "$(y "fetch failed — using local refs")"
    if ! git rev-parse --verify --quiet "${pin}^{commit}" >/dev/null; then
      say "$(r "pinned ref '$pin' does not exist")"; return 1
    fi
    git checkout --quiet --detach "$pin" 2>/dev/null || { say "$(r "checkout of '$pin' failed")"; return 1; }
    say "pinned to $(b "$pin")  ($(git log --oneline -1 | cut -c1-60))"
    lockfile_changed "$started_at" "$(git rev-parse HEAD)" && sync_deps
    return 0
  fi

  local branch; branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  if [ "$branch" = "HEAD" ]; then
    say "$(y "detached HEAD and no pin set — returning to main")"
    git checkout --quiet main || { say "$(r "could not switch to main")"; return 1; }
    branch=main
  fi
  [ "$branch" = "main" ] || say "$(y "on branch '$branch', not main")"

  local before after
  before="$started_at"

  if ! git pull --ff-only 2>&1 | sed 's/^/      /'; then
    say "$(y "pull failed — continuing with the code already on disk")"
    say "(working tree is unchanged; --ff-only cannot leave a half-merge)"
    return 0
  fi

  after=$(git rev-parse HEAD)

  if [ "$before" = "$after" ]; then
    say "already up to date  ($(git log --oneline -1 | cut -c1-60))"
    return 0
  fi


  say "updated $(echo "$before" | cut -c1-7) -> $(echo "$after" | cut -c1-7)"
  git --no-pager log --oneline "$before..$after" | head -8 | sed 's/^/      /'

  lockfile_changed "$before" "$after" && sync_deps
  return 0
}

# ---- start -----------------------------------------------------------------

do_start() {
  [ -f "$PLIST" ] || { say "$(r "no plist at $PLIST")"; exit 1; }

  if [ "$(running_count)" -gt 0 ]; then
    say "$(y "already running on this laptop") (pid $(running_pids | tr '\n' ' '))"
    say "nothing to do — use 'trader-ctl status' to inspect"
    exit 0
  fi

  # Pull first, so preflight below validates the code we will actually run —
  # in particular a requirements.lock change that has not been installed yet.
  if [ "$NO_PULL" -eq 1 ]; then
    head_ "updating code"; say "$(y "skipped (--no-pull)")"
  else
    do_update || { echo; say "$(r "update failed — not starting")"; exit 1; }
  fi

  # Preflight before we start anything.
  head_ "preflight"
  local py fail=0; py=$(plist_python)
  if [ -x "$py" ]; then say "interpreter: $(g "ok")  $py"; else say "interpreter: $(r "missing")  '$py'"; fail=1; fi
  if "$py" -c "import robin_stocks, yfinance, scipy, fastapi, uvicorn" 2>/dev/null; then
    say "dependencies: $(g "ok")"
  else
    say "dependencies: $(r "missing for that interpreter — job would crash-loop")"; fail=1
  fi
  if [ -f "$REPO/.env" ]; then say "credentials: $(g "ok")  ($(wc -c < "$REPO/.env" | tr -d ' ') bytes)"; else say "credentials: $(r ".env missing")"; fail=1; fi
  local gv; gv=$(gate_value)
  if [ "$gv" = "False" ]; then say "trading gate: $(g "disarmed")  — will place real orders"
  elif [ "$gv" = "True" ]; then say "trading gate: $(r "ARMED — trading would be silently disabled")"; fail=1
  else say "trading gate: $(y "unknown")"; fail=1; fi
  [ "$fail" -eq 0 ] || { echo; say "$(r "preflight failed — not starting")"; exit 1; }

  if [ "$ASSUME_YES" -ne 1 ]; then
    echo
    printf "  "; r "Only ONE laptop may run the scheduler."; printf "\n"
    printf "  Two running schedulers place two sets of live orders on the same account.\n"
    printf "  The lock is per-machine and cannot detect the other laptop.\n\n"
    printf "  Confirm the OTHER laptop is stopped, then type "; b "yes"; printf ": "
    read -r ans
    [ "$ans" = "yes" ] || { say "aborted"; exit 1; }
  fi

  head_ "starting"
  # Keep launchd's own message. When a start fails it is the actual diagnostic,
  # and "check launchd.stderr.log" is useless if the job never got far enough to
  # write one (bad interpreter path, malformed plist, already-loaded label).
  local lderr; lderr=$(launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>&1)
  if [ -n "$lderr" ]; then
    say "$(y "bootstrap: $lderr")"
    launchctl kickstart -k "gui/$(id -u)/$LABEL" >/dev/null 2>&1
  fi
  for i in $(seq 1 20); do [ "$(running_count)" -ge 1 ] && break; sleep 1; done

  local n; n=$(running_count)
  if [ "$n" -eq 1 ]; then
    say "$(g "started")  pid $(running_pids)"
  elif [ "$n" -eq 0 ]; then
    say "$(r "failed to start")"
    [ -n "$lderr" ] && say "launchd said: $lderr"
    say "also check $REPO/logs/launchd.stderr.log"
    exit 1
  else
    say "$(r "$n processes running — investigate immediately")"
    exit 1
  fi

  sleep 3
  if grep -q "Signal handlers installed" "$REPO/logs/options_trader.log" 2>/dev/null; then
    say "startup log looks correct"
  else
    say "$(y "no startup line yet — check logs/options_trader.log")"
  fi

  head_ "one manual step remains"
  say "Ask Claude on this laptop:  $(b "enable my verify-daily-pipeline scheduled task")"
  say "(schedules live in the Claude service, not on disk — no CLI can toggle them)"
  echo
}

# ---- stop ------------------------------------------------------------------

do_stop() {
  head_ "stopping"
  if [ -z "$(launchd_line)" ] && [ "$(running_count)" -eq 0 ]; then
    say "already stopped"
  else
    local berr; berr=$(launchctl bootout "gui/$(id -u)/$LABEL" 2>&1)
    [ -n "$berr" ] && say "$(y "bootout: $berr")"
    for i in $(seq 1 20); do [ "$(running_count)" -eq 0 ] && break; sleep 1; done
    if [ "$(running_count)" -eq 0 ]; then
      say "$(g "stopped")  — launchd job unloaded, no scheduler process"
    else
      say "$(r "still running") (pid $(running_pids | tr '\n' ' '))"
      [ -n "$berr" ] && say "launchd said: $berr"
      say "bootout did not take effect; investigate before starting the other laptop"
      exit 1
    fi
  fi

  head_ "one manual step remains"
  say "Ask Claude on this laptop:  $(b "disable my verify-daily-pipeline scheduled task")"
  say "Otherwise it fires every weekday, finds no fresh artifacts here, and sends a"
  say "false critical alarm email."
  echo
}

# ---- main ------------------------------------------------------------------

cmd="${1:-}"; shift 2>/dev/null
pin_arg=""
while [ $# -gt 0 ]; do
  case "$1" in
    -y) ASSUME_YES=1 ;;
    --no-pull) NO_PULL=1 ;;
    --ref) shift; REF_OVERRIDE="${1:-}" ;;
    *) [ -z "$pin_arg" ] && pin_arg="$1" ;;
  esac
  shift
done

case "$cmd" in
  start)  do_start ;;
  stop)   do_stop ;;
  status) do_status ;;
  pin)    do_pin "$pin_arg" ;;
  *)      usage ;;
esac
